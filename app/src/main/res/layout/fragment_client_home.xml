<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Shadow layer (gives depth illusion) -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <!-- Bottom shadow circle -->
            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_shadow" />

            <!-- Actual button -->
            <Button
                android:id="@+id/btnCreateJob"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:text="REQUEST&#10;SERVICE"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.05"
                android:lineSpacingExtra="4dp"
                android:background="@drawable/bg_button_push"
                android:stateListAnimator="@null" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to request a service"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.03" />

    </LinearLayout>

</FrameLayout>